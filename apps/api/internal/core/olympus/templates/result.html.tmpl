{{template "head" .}}
<section class="card">
<h2>{{.Heading}}</h2>
{{if .ShowCounts}}
<p class="notice notice-ok" role="status">Added {{.Added}} record{{if ne .Added 1}}s{{end}}. Skipped {{.Skipped}} already in your data.</p>
{{else}}
<p class="notice notice-error" role="alert">{{.Message}}</p>
{{end}}
{{if .Rows}}
<ul class="rows">
{{range .Rows}}<li>Row {{.Row}}: {{.Reason}}</li>
{{end}}</ul>
{{if .More}}<p class="muted">and {{.More}} more.</p>{{end}}
{{end}}
<p><a class="button" href="/">Back to status</a></p>
</section>
{{template "foot" .}}
