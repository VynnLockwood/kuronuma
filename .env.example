# Copy to .env and fill in. Never commit .env.

# Database password for the bundled Postgres (used only inside the compose network).
# Required: compose refuses to start while this is empty. Choose a long random value: openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs the short-lived login cookie. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# The external origin users visit. No trailing slash, no path.
# Local: http://localhost:8080   Hosted: https://your-domain
PUBLIC_URL=http://localhost:8080
# Host port nginx listens on (local use).
HTTP_PORT=8080

# Google OAuth client (see README "Google sign-in setup"). Leave both empty to run with sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Comma-separated emails allowed to sign in. Empty = any verified Google account.
# Recommended while testing: ALLOWED_EMAILS=you@gmail.com
ALLOWED_EMAILS=

# Optional. Session lifetime (Go duration).
SESSION_TTL=336h
